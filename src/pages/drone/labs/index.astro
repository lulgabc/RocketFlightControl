---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SectionHead from "../../../components/SectionHead.astro";
import { url } from "../../../lib/url";

const labs = [
  {
    index: "01",
    title: "PX4 SITL + Offboard 方形",
    detail: "Gazebo 起飞、速度控制方形、降落；把 MAVSDK 与 PX4 的接口跑通。",
    status: "可开始",
    href: "/drone/labs/offboard/",
  },
  {
    index: "01B",
    title: "位置设定点 + 风扰 + 失败注入",
    detail: "把速度方形升级为 NED 位置设定点，在 windy 世界测误差，并主动丢 setpoint 观察 failsafe。",
    status: "可开始",
    href: "/drone/labs/position/",
  },
  {
    index: "02",
    title: "VIO 悬停与外部视觉",
    detail: "gz_x500_vision 注入外部视觉，配置 EKF2 EV 融合，做位置保持与小平移。",
    status: "可开始",
    href: "/drone/labs/vio/",
  },
  {
    index: "03",
    title: "离线 VIO：OpenVINS / VINS-Fusion",
    detail: "EuRoC 数据集、ROS 2 bag 转换、OpenVINS/VINS-Fusion 轨迹与 ATE/RPE 对比，以及 VIO→PX4 的 yaw/延迟标定、EKF innovation、EV 跳变/丢失与地面静态测试。",
    status: "可开始",
    href: "/drone/labs/vio-offline/",
  },
  {
    index: "04",
    title: "Jetson 伴飞检测",
    detail: "相机 + TensorRT + MAVSDK，在功耗/热预算内做检测与速度限制。",
    status: "规划中",
  },
  {
    index: "05",
    title: "Crazyflie 蜂群",
    detail: "UWB + Crazyswarm2，从 1 台到 10 台编队，测时间同步与碰撞距离。",
    status: "规划中",
  },
  {
    index: "06",
    title: "Remote ID 与围栏",
    detail: "Open Drone ID、geofence、failsafe；做一次合规与失效演练。",
    status: "规划中",
  },
];
---

<BaseLayout
  title="无人机实验室"
  description="无人机可实践实验：PX4 SITL + MAVSDK Offboard、外部视觉、OpenVINS 离线 VIO、Jetson 边缘 AI、Crazyflie 蜂群与 Remote ID。每个 Lab 有环境、代码、验收与失效模式。"
  current="/drone/"
>
  <section class="page-hero">
    <div class="container">
      <div class="page-hero-top">
        <a href={url("/drone/")}>无人机</a>
        <span>/</span>
        <span>Labs</span>
      </div>
      <h1>先让它在仿真里<br />飞一个方形。</h1>
      <p>
        这是无人机版块的实践入口。Lab 01 用 PX4 SITL + MAVSDK 完成“连接 → 健康检查 → 起飞 → Offboard 方形 → 降落”，
        Lab 02/03 再把外部视觉与真实 VIO 算法拆开验证。所有实验先在仿真/台架完成，再考虑真机。
      </p>
      <div class="page-hero-meta">
        <span>实验 <b>{labs.length} 个</b></span>
        <span>可开始 <b>4 个</b></span>
        <span>环境 <b>Ubuntu 22.04 / 24.04</b></span>
        <span>仿真 <b>PX4 SITL + Gazebo</b></span>
        <span>接口 <b>MAVSDK / ROS 2</b></span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        eyebrow="Lab roadmap"
        title="六个实验，从单机到蜂群"
        lead="Lab 01/01B/02/03 已可复现；其余按“仿真 → 台架 → 真机”的顺序补齐。每个 Lab 都要求可复现、可测量、可失效。"
      />
      <div class="build-grid">
        {labs.map((lab) => (
          <article class="build-card reveal">
            <span class="build-week">{lab.index} · {lab.status}</span>
            <h3>{lab.title}</h3>
            <p>{lab.detail}</p>
            {lab.href ? (
              <div class="build-gate"><a href={url(lab.href)}>进入 {lab.index} →</a></div>
            ) : (
              <div class="build-gate">待发布</div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <div class="callout reveal">
        <span class="callout-icon" aria-hidden="true">!</span>
        <div>
          <h3>Lab 01 是仿真，不是飞行许可</h3>
          <p>
            本实验只连接 PX4 SITL 与 Gazebo。真机飞行需要空域、Remote ID、场地、保险与当地法规；
            首次真机测试应拆桨/系留/护网，并由有经验的人陪同。
          </p>
        </div>
        <a class="btn btn-ghost btn-sm" href={url("/drone/safety/")}>安全与空域</a>
      </div>
    </div>
  </section>
</BaseLayout>
