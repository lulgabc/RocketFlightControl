---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHead from "../../components/SectionHead.astro";
import { url } from "../../lib/url";
import { ENGINEERING_TOPICS, type EngineeringTopic } from "../../data/engineering";

export function getStaticPaths() {
  return ENGINEERING_TOPICS.map((topic, index) => ({
    params: { slug: topic.slug },
    props: {
      topic,
      prev: ENGINEERING_TOPICS[(index - 1 + ENGINEERING_TOPICS.length) % ENGINEERING_TOPICS.length],
      next: ENGINEERING_TOPICS[(index + 1) % ENGINEERING_TOPICS.length],
    },
  }));
}

interface Props {
  topic: EngineeringTopic;
  prev: EngineeringTopic;
  next: EngineeringTopic;
}

const { topic, prev, next } = Astro.props;
---

<BaseLayout
  title={`${topic.title} · 工程核心`}
  description={`${topic.summary} 含第一性原理公式、工程权衡、失效模式、参考型号、开源项目与专业资源。`}
  current="/engineering/"
>
  <section class:list={["page-hero", "org-hero", `accent-${topic.accent}`]}>
    <div class="container">
      <div class="page-hero-top">
        <a href={url("/engineering/")}>工程核心</a>
        <span>/</span>
        <span>{topic.en}</span>
      </div>
      <span class="eyebrow">{topic.index} · {topic.en}</span>
      <h1>{topic.title}</h1>
      <p>{topic.summary}</p>
      <div class="stats-grid org-stats-strip">
        {topic.stats.map((stat) => (
          <div class="stat">
            <div class="stat-value">{stat.value}</div>
            <div class="stat-label">{stat.label}</div>
            {stat.note && <div class="stat-note">{stat.note}</div>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        eyebrow="First principles"
        title="先把方程写对"
        lead="公式不是装饰。每个公式都要能回答：变量是什么、假设是什么、在哪个区间失效、如何用数据验证。"
      />
      <div class="equation-grid">
        {topic.equations.map((equation) => (
          <article class="equation-card reveal">
            <h3>{equation.title}</h3>
            <code class="formula-line">{equation.formula}</code>
            <p>{equation.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <SectionHead
        eyebrow="Architecture"
        title={topic.breakdownTitle}
        lead={topic.breakdownLead}
      />
      <div class="core-grid">
        {topic.breakdown.map((item) => (
          <article class="core-card reveal">
            <h3>{item.name}</h3>
            <p>{item.detail}</p>
            <div class="core-metrics">
              {item.metrics.map((metric) => (
                <span>{metric}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <SectionHead
        eyebrow="Trade space"
        title={topic.tradeoffTitle}
        lead={topic.tradeoffLead}
      />
      <div class="matrix-wrap reveal">
        <table class="matrix tradeoff-table">
          <thead>
            <tr>
              <th scope="col">选择</th>
              <th scope="col">优势</th>
              <th scope="col">代价</th>
              <th scope="col">适用</th>
            </tr>
          </thead>
          <tbody>
            {topic.tradeoffs.map((item) => (
              <tr>
                <td>{item.option}</td>
                <td>{item.pros}</td>
                <td>{item.cons}</td>
                <td>{item.use}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <SectionHead
        eyebrow="Failure modes"
        title={topic.failureTitle}
        lead="专业设计不是“不会坏”，而是知道会怎么坏、怎么发现、怎么把后果限制在可接受范围。"
      />
      <div class="matrix-wrap reveal">
        <table class="matrix failure-table">
          <thead>
            <tr>
              <th scope="col">失效模式</th>
              <th scope="col">机理 / 触发</th>
              <th scope="col">缓解 / 验证</th>
            </tr>
          </thead>
          <tbody>
            {topic.failures.map((item) => (
              <tr>
                <td>{item.mode}</td>
                <td>{item.cause}</td>
                <td>{item.mitigation}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <SectionHead
        eyebrow="Reference systems"
        title={topic.referenceTitle}
        lead={topic.referenceLead}
      />
      <div class="matrix-wrap reveal">
        <table class="matrix reference-table">
          <thead>
            <tr>
              <th scope="col">型号 / 任务</th>
              <th scope="col">要点</th>
            </tr>
          </thead>
          <tbody>
            {topic.references.map((item) => (
              <tr>
                <td>
                  {item.href ? (
                    <a href={item.href} target="_blank" rel="noopener noreferrer">{item.name}</a>
                  ) : (
                    item.name
                  )}
                </td>
                <td>{item.detail}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <SectionHead
        eyebrow="Library"
        title="书、标准与数据"
        lead="每页只保留真正会被翻开的入口。书籍不强行给链接；工具与标准优先链接官方页面。"
      />
      <div class="resource-grid">
        {topic.resources.map((resource) => (
          <article class="resource-card reveal">
            <div class="resource-top">
              <span class="tag accent">{resource.type}</span>
              <span class="tag">{resource.level}</span>
            </div>
            <h2>{resource.title}</h2>
            <div class="resource-author">{resource.author}</div>
            <p class="resource-note">{resource.note}</p>
            {resource.href && (
              <a class="resource-link" href={resource.href} target="_blank" rel="noopener noreferrer">
                打开资源 ↗
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <SectionHead
        eyebrow="Open source"
        title="可以动手的开源项目"
        lead="这些项目不替代教材，但能让你把公式跑起来、把参数扫起来、把失败复现出来。"
      />
      <div class="link-grid">
        {topic.projects.map((project) => (
          <a class="link-card reveal" href={project.href} target="_blank" rel="noopener noreferrer">
            <span class="link-card-arrow" aria-hidden="true">↗</span>
            <h3>{project.name}</h3>
            <p>{project.note} · {project.lang}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <div class="callout reveal">
        <span class="callout-icon" aria-hidden="true">!</span>
        <div>
          <h3>边界与安全</h3>
          <p>{topic.boundaries}</p>
        </div>
        <a class="btn btn-ghost btn-sm" href="#sources">查看来源</a>
      </div>

      <div class="learn-block reveal">
        <h3>对应学习路径</h3>
        <div class="resource-chips">
          {topic.learn.map((item) => (
            <a class="resource-chip" href={url(item.href)}>{item.label}</a>
          ))}
        </div>
      </div>

      <div class="source-grid" id="sources">
        <div class="source-head">
          <h3>来源</h3>
          <span class="tag">{topic.sources.length} 条</span>
        </div>
        <ul>
          {topic.sources.map((source) => (
            <li><a href={source.href} target="_blank" rel="noopener noreferrer">{source.label} ↗</a></li>
          ))}
        </ul>
      </div>

      <nav class="org-nav" aria-label="工程核心页面导航">
        <a href={url(`/engineering/${prev.slug}/`)}>
          <span>← 上一页</span>
          <b>{prev.title}</b>
        </a>
        <a href={url("/engineering/")} class="org-nav-all">全部主题</a>
        <a href={url(`/engineering/${next.slug}/`)}>
          <span>下一页 →</span>
          <b>{next.title}</b>
        </a>
      </nav>
    </div>
  </section>
</BaseLayout>
