---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  linkHref?: string;
  linkLabel?: string;
}

const { eyebrow, title, lead, linkHref, linkLabel } = Astro.props;
---

<div class="section-head reveal">
  <div>
    <span class="eyebrow">{eyebrow}</span>
    <h2>{title}</h2>
    {lead && <p>{lead}</p>}
  </div>
  {linkHref && linkLabel && (
    <a class="section-link" href={linkHref}>
      {linkLabel} <span aria-hidden="true">→</span>
    </a>
  )}
</div>
